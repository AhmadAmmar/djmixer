{
  "name": "mix-and-learn",
  "version": "0.5.0",
  "private": true,
  "description": "Learn music and DJ mixing by measuring real tracks: one web app for desktop browsers and Android",
  "type": "module",
  "scripts": {
    "serve": "python dev/serve.py",
    "test": "node web/test_dsp.mjs && node web/test_mix.mjs",
    "analyse": "node tools/analyse.mjs",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "dependencies": {
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4"
  }
}
